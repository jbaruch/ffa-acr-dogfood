# Optional secrets for inherited GitHub Actions workflows in this repo.
# Actions, including the Tessl publication workflow, are disabled. These secrets
# are not prerequisites for manual ACR publication. If those workflows are
# separately authorized for use, set secrets in this repo's settings — never copy
# them into a local .env, and never commit a real value:
#   https://github.com/jbaruch/ffa-acr-dogfood/settings/secrets/actions

# FLEET_DISPATCH_TOKEN — the token .github/workflows/review-trigger.yml reads to start the
#   review run in jbaruch/coding-policy. Create it with Actions: Read and write on
#   jbaruch/coding-policy.
FLEET_DISPATCH_TOKEN=

# TESSL_TOKEN — authenticates the skill review and plugin publish in
#   .github/workflows/publish.yml. Generate one at https://tessl.io under account settings.
TESSL_TOKEN=
