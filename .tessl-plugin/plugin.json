{
  "name": "jbaruch/ffa-acr-dogfood",
  "version": "0.9.38",
  "description": "Write professional, persuasive complaint letters to US airlines emphasizing loyalty status, DOT regulations, and airline commitments.",
  "private": false,
  "skills": [
    "skills/frequent-flyer-advocate",
    "skills/using-travel-credits"
  ],
  "rules": [
    "rules/boundaries.md",
    "rules/letter-quality.md",
    "rules/escalation-output.md",
    "rules/complaint-patterns.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${TESSL_PLUGIN_DIR}/hooks/session-start-tessl-update.sh"
            ]
          }
        ]
      }
    ]
  },
  "repository": "https://github.com/jbaruch/ffa-acr-dogfood"
}
